# OpenCode (OpenAI互換エンドポイント) の認証情報。
# このファイルを opencode.env にコピーして値を入れる。opencode.env は .gitignore 済み。
#
#   cp opencode.env.example opencode.env
#   $EDITOR opencode.env
#   docker compose up -d      # 再作成で反映される
#
# 反映確認:
#   docker compose exec claude-code-proxy sh -c 'echo "${CCP_OPENCODE_API_KEY:+set}"'

CCP_OPENCODE_API_KEY=

# --- 以下は任意。使わない行はコメントアウトしたままにすること ---

# 別の OpenAI互換エンドポイントを使う場合のみ設定する。
# 未設定・空文字ならいずれも既定値 (https://opencode.ai/zen/go/v1) が使われる。
#CCP_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
